# Local development only. Copy to .env and keep the real file out of git.
DATABASE_URL="postgresql://digital_asset:digital_asset_dev@localhost:55432/digital_asset_dev?schema=public"

# Phase 1 only stores key references in DB. Real Binance values stay in .env.
BINANCE_MASTER_READ_KEY_REF="BINANCE_MASTER_READ_KEY"
BINANCE_MASTER_READ_SECRET_REF="BINANCE_MASTER_READ_SECRET"

# P1.5 shadow market-data collector (Binance public futures-data, no key required).
# Disabled by default; the verification gate never hits the real network.
# Enable only when you intentionally start collecting real shadow facts.
BINANCE_FAPI_BASE_URL="https://fapi.binance.com"
MARKET_DATA_SHADOW_ENABLED="false"
MARKET_DATA_SHADOW_SYMBOLS="BTCUSDT"
MARKET_DATA_SHADOW_PERIOD="1h"
MARKET_DATA_SHADOW_LIMIT="48"
