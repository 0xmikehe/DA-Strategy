generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobRunStatus {
  queued
  running
  succeeded
  failed
  skipped
}

enum JobType {
  ledger_sync
  signal_fact_collect
  signal_snapshot_build
  strategy_review_draft
}

model JobRun {
  id           String       @id @default(uuid())
  jobType      JobType      @map("job_type")
  targetKey    String?      @map("target_key")
  status       JobRunStatus @default(queued)
  attempts     Int          @default(0)
  errorMessage String?      @map("error_message")
  startedAt    DateTime?    @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([jobType, status, createdAt])
  @@map("job_run")
}

model SyncCursor {
  id            String    @id @default(uuid())
  owner         String
  cursorKey     String    @map("cursor_key")
  cursorValue   String?   @map("cursor_value")
  highWatermark DateTime? @map("high_watermark")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([owner, cursorKey])
  @@map("sync_cursor")
}

model DecisionSnapshot {
  snapshotId        String   @id @map("snapshot_id")
  schemaVersion     String   @map("schema_version")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")
  contentHash       String   @map("content_hash")
  contentRef        String?  @map("content_ref")
  contentJson       Json?    @map("content_json")
  immutabilityState String   @default("sealed") @map("immutability_state")

  @@index([createdAt])
  @@map("decision_snapshot")
}

enum LedgerDataSourceMode {
  fixture
  mock
  cassette
  remote_import
  live
}

enum LedgerFactKind {
  exchange_trade_fill
  exchange_order
  capital_flow_event
  external_trade
  attribution_record
  reversal
  account_balance_snapshot
}

enum LedgerFactObservationStatus {
  inserted
  duplicate
}

model LedgerIngestBatch {
  id              String               @id @default(uuid())
  idempotencyKey  String               @unique @map("idempotency_key")
  sourceMode      LedgerDataSourceMode @map("source_mode")
  defaultOrigin   Json?                @map("default_origin")
  actor           Json
  trigger         Json
  requestedAt     DateTime             @map("requested_at")
  packageMetadata Json?                @map("package_metadata")
  importMetadata  Json?                @map("import_metadata")
  syncMetadata    Json?                @map("sync_metadata")
  canonicalHash   String               @map("canonical_hash")
  resultSummary   Json?                @map("result_summary")
  createdAt       DateTime             @default(now()) @map("created_at")

  observations LedgerFactObservation[]

  @@index([sourceMode, requestedAt])
  @@map("ledger_ingest_batch")
}

model LedgerFactObservation {
  id             String                      @id @default(uuid())
  batchId        String                      @map("batch_id")
  factKind       LedgerFactKind              @map("fact_kind")
  factTableId    String                      @map("fact_table_id")
  idempotencyKey String                      @map("idempotency_key")
  naturalKey     String                      @map("natural_key")
  payloadHash    String                      @map("payload_hash")
  status         LedgerFactObservationStatus
  createdAt      DateTime                    @default(now()) @map("created_at")

  batch LedgerIngestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([factKind, naturalKey])
  @@index([idempotencyKey])
  @@map("ledger_fact_observation")
}

model ExchangeTradeFill {
  id                String               @id @default(uuid())
  idempotencyKey    String               @unique @map("idempotency_key")
  naturalKey        String               @unique @map("natural_key")
  sourceMode        LedgerDataSourceMode @map("source_mode")
  origin            Json
  occurredAt        DateTime             @map("occurred_at")
  sourceEventTime   DateTime?            @map("source_event_time")
  exchangeAccountId String?              @map("exchange_account_id")
  asset             String?
  baseAsset         String?              @map("base_asset")
  quoteAsset        String?              @map("quote_asset")
  symbol            String?
  externalId        String?              @map("external_id")
  strategyId        String?              @map("strategy_id")
  strategyVersion   String?              @map("strategy_version")
  snapshotId        String?              @map("snapshot_id")
  snapshotTime      DateTime?            @map("snapshot_time")
  reportedScope     String?              @map("reported_scope")
  payloadHash       String               @map("payload_hash")
  payload           Json
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([sourceMode, occurredAt])
  @@index([exchangeAccountId, occurredAt])
  @@index([asset, occurredAt])
  @@index([strategyId, occurredAt])
  @@map("exchange_trade_fill")
}

