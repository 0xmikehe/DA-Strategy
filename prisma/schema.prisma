generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobRunStatus {
  queued
  running
  succeeded
  failed
  skipped
}

enum JobType {
  ledger_sync
  signal_fact_collect
  signal_snapshot_build
  strategy_review_draft
}

enum StrategyVersionStatus {
  draft
  active
  superseded
  retired
}

enum AssetRole {
  stable
  core
  satellite
  fee_asset
}

enum AssetStatus {
  active
  disabled
  retired
}

enum BindingState {
  active
  warn
  blocked
}

enum PlannedActionStatus {
  draft
  confirmed
  dismissed
  executed_manually
}

enum ReviewDraftStatus {
  draft
  confirmed
  superseded
}

enum TradeSide {
  buy
  sell
}

enum CapitalFlowType {
  deposit
  withdrawal
  transfer_in
  transfer_out
}

model JobRun {
  id           String       @id @default(uuid())
  jobType      JobType      @map("job_type")
  targetKey    String?      @map("target_key")
  status       JobRunStatus @default(queued)
  attempts     Int          @default(0)
  errorMessage String?      @map("error_message")
  startedAt    DateTime?    @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([jobType, status, createdAt])
  @@map("job_run")
}

model SyncCursor {
  id            String    @id @default(uuid())
  owner         String
  cursorKey     String    @map("cursor_key")
  cursorValue   String?   @map("cursor_value")
  highWatermark DateTime? @map("high_watermark")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([owner, cursorKey])
  @@map("sync_cursor")
}

model DecisionSnapshot {
  snapshotId        String   @id @map("snapshot_id")
  schemaVersion     String   @map("schema_version")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")
  contentHash       String   @map("content_hash")
  contentRef        String?  @map("content_ref")
  contentJson       Json?    @map("content_json")
  immutabilityState String   @default("sealed") @map("immutability_state")

  ledgerEvents     LedgerEvent[]
  plannedActions   PlannedAction[]
  tradeFills       ExchangeTradeFill[]

  @@index([createdAt])
  @@map("decision_snapshot")
}

model StrategyVersion {
  id            String                @id @default(uuid())
  strategyId    String                @map("strategy_id")
  version       String
  status        StrategyVersionStatus
  effectiveFrom DateTime              @map("effective_from")
  effectiveTo   DateTime?             @map("effective_to")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  assetPoolItems AssetPoolItem[]
  bindings       StrategyAccountBinding[]
  plannedActions PlannedAction[]
  reviewDrafts   ReviewDraft[]
  tradeFills     ExchangeTradeFill[]

  @@unique([strategyId, version])
  @@index([status, effectiveFrom])
  @@map("strategy_version")
}

model AssetPoolItem {
  id              String          @id @default(uuid())
  strategyId      String          @map("strategy_id")
  strategyVersion String          @map("strategy_version")
  asset           String
  role            AssetRole
  status          AssetStatus
  effectiveFrom   DateTime        @map("effective_from")
  effectiveTo     DateTime?       @map("effective_to")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  strategy StrategyVersion @relation(fields: [strategyId, strategyVersion], references: [strategyId, version])

  @@unique([strategyId, strategyVersion, asset])
  @@index([strategyId, strategyVersion])
  @@map("asset_pool_item")
}

model PlannedAction {
  actionId                String              @id @default(uuid()) @map("action_id")
  strategyId              String              @map("strategy_id")
  strategyVersion         String              @map("strategy_version")
  snapshotId              String              @map("snapshot_id")
  actionType              String              @map("action_type")
  targetAllocationBandRef String              @map("target_allocation_band_ref")
  reasonCodes             Json                @map("reason_codes")
  status                  PlannedActionStatus
  createdAt               DateTime            @default(now()) @map("created_at")

  strategy StrategyVersion  @relation(fields: [strategyId, strategyVersion], references: [strategyId, version])
  snapshot DecisionSnapshot @relation(fields: [snapshotId], references: [snapshotId])

  @@index([strategyId, strategyVersion, createdAt])
  @@index([snapshotId])
  @@index([status, createdAt])
  @@map("planned_action")
}

model ReviewDraft {
  reviewId        String            @id @default(uuid()) @map("review_id")
  strategyId      String            @map("strategy_id")
  strategyVersion String            @map("strategy_version")
  periodStart     DateTime          @map("period_start")
  periodEnd       DateTime          @map("period_end")
  snapshotRefs    Json              @map("snapshot_refs")
  sections        Json
  status          ReviewDraftStatus
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  strategy StrategyVersion @relation(fields: [strategyId, strategyVersion], references: [strategyId, version])

  @@index([strategyId, strategyVersion, periodStart])
  @@index([status, createdAt])
  @@map("review_draft")
}

model MarketCandleFact {
  id         String   @id @default(uuid())
  source     String
  symbol     String
  interval   String
  openTime   DateTime @map("open_time")
  closeTime  DateTime @map("close_time")
  open       Decimal  @db.Decimal(38, 18)
  high       Decimal  @db.Decimal(38, 18)
  low        Decimal  @db.Decimal(38, 18)
  close      Decimal  @db.Decimal(38, 18)
  volume     Decimal  @db.Decimal(38, 18)
  rawPayload Json     @map("raw_payload")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([source, symbol, interval, openTime])
  @@index([symbol, interval, openTime])
  @@map("market_candle_fact")
}

model FundingRateFact {
  id          String   @id @default(uuid())
  source      String
  symbol      String
  fundingTime DateTime @map("funding_time")
  fundingRate Decimal  @map("funding_rate") @db.Decimal(38, 18)
  markPrice   Decimal? @map("mark_price") @db.Decimal(38, 18)
  rawPayload  Json     @map("raw_payload")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([source, symbol, fundingTime])
  @@index([symbol, fundingTime])
  @@map("funding_rate_fact")
}

model ExchangeAccount {
  id                 String   @id @default(uuid())
  exchange           String
  accountRole        String   @map("account_role")
  accountLabel       String   @map("account_label")
  externalAccountRef String?  @map("external_account_ref")
  keyRef             String?  @map("key_ref")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  bindings     StrategyAccountBinding[]
  ledgerEvents LedgerEvent[]
  tradeFills   ExchangeTradeFill[]
  capitalFlows CapitalFlowEvent[]

  @@unique([exchange, externalAccountRef])
  @@index([exchange, accountRole])
  @@map("exchange_account")
}

model StrategyAccountBinding {
  id                String       @id @default(uuid())
  strategyId        String       @map("strategy_id")
  strategyVersion   String       @map("strategy_version")
  exchangeAccountId String       @map("exchange_account_id")
  bindingState      BindingState @map("binding_state")
  effectiveFrom     DateTime     @map("effective_from")
  effectiveTo       DateTime?    @map("effective_to")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  strategy       StrategyVersion @relation(fields: [strategyId, strategyVersion], references: [strategyId, version])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([strategyId, strategyVersion])
  @@index([exchangeAccountId])
  @@index([bindingState])
  @@map("strategy_account_binding")
}

model LedgerEvent {
  eventId           String   @id @default(uuid()) @map("event_id")
  eventType         String   @map("event_type")
  exchangeAccountId String   @map("exchange_account_id")
  strategyId        String?  @map("strategy_id")
  strategyVersion   String?  @map("strategy_version")
  snapshotId        String?  @map("snapshot_id")
  eventTime         DateTime @map("event_time")
  source            String
  externalId        String?  @map("external_id")
  idempotencyKey    String   @map("idempotency_key")
  rawPayload        Json     @map("raw_payload")
  createdAt         DateTime @default(now()) @map("created_at")

  exchangeAccount ExchangeAccount   @relation(fields: [exchangeAccountId], references: [id])
  snapshot        DecisionSnapshot? @relation(fields: [snapshotId], references: [snapshotId])
  tradeFill       ExchangeTradeFill?
  capitalFlow     CapitalFlowEvent?

  @@unique([exchangeAccountId, eventType, idempotencyKey])
  @@index([strategyId, strategyVersion, eventTime])
  @@index([snapshotId])
  @@index([eventType, eventTime])
  @@map("ledger_event")
}

model ExchangeTradeFill {
  tradeId           String    @id @default(uuid()) @map("trade_id")
  ledgerEventId     String    @unique @map("ledger_event_id")
  exchangeAccountId String    @map("exchange_account_id")
  strategyId        String    @map("strategy_id")
  strategyVersion   String    @map("strategy_version")
  snapshotId        String    @map("snapshot_id")
  symbol            String
  side              TradeSide
  price             Decimal   @db.Decimal(38, 18)
  qty               Decimal   @db.Decimal(38, 18)
  commissionAsset   String    @map("commission_asset")
  commissionQty     Decimal   @map("commission_qty") @db.Decimal(38, 18)
  time              DateTime
  externalTradeId   String    @map("external_trade_id")
  rawPayload        Json      @map("raw_payload")
  createdAt         DateTime  @default(now()) @map("created_at")

  ledgerEvent     LedgerEvent      @relation(fields: [ledgerEventId], references: [eventId])
  exchangeAccount ExchangeAccount  @relation(fields: [exchangeAccountId], references: [id])
  strategy        StrategyVersion  @relation(fields: [strategyId, strategyVersion], references: [strategyId, version])
  snapshot        DecisionSnapshot @relation(fields: [snapshotId], references: [snapshotId])

  @@unique([exchangeAccountId, externalTradeId])
  @@index([strategyId, strategyVersion, time])
  @@index([snapshotId])
  @@index([ledgerEventId])
  @@map("exchange_trade_fill")
}

model CapitalFlowEvent {
  eventId           String          @id @default(uuid()) @map("event_id")
  ledgerEventId     String          @unique @map("ledger_event_id")
  exchangeAccountId String          @map("exchange_account_id")
  strategyId        String?         @map("strategy_id")
  flowType          CapitalFlowType @map("flow_type")
  asset             String
  amount            Decimal         @db.Decimal(38, 18)
  eventTime         DateTime        @map("event_time")
  sourceAccount     String?         @map("source_account")
  targetAccount     String?         @map("target_account")
  externalId        String?         @map("external_id")
  rawPayload        Json            @map("raw_payload")
  createdAt         DateTime        @default(now()) @map("created_at")

  ledgerEvent     LedgerEvent     @relation(fields: [ledgerEventId], references: [eventId])
  exchangeAccount ExchangeAccount @relation(fields: [exchangeAccountId], references: [id])

  @@index([strategyId, eventTime])
  @@index([exchangeAccountId, eventTime])
  @@index([ledgerEventId])
  @@map("capital_flow_event")
}
