generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobRunStatus {
  queued
  running
  succeeded
  failed
  skipped
}

enum JobType {
  ledger_sync
  signal_fact_collect
  signal_snapshot_build
  strategy_review_draft
}

model JobRun {
  id           String       @id @default(uuid())
  jobType      JobType      @map("job_type")
  targetKey    String?      @map("target_key")
  status       JobRunStatus @default(queued)
  attempts     Int          @default(0)
  errorMessage String?      @map("error_message")
  startedAt    DateTime?    @map("started_at")
  finishedAt   DateTime?    @map("finished_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([jobType, status, createdAt])
  @@map("job_run")
}

model SyncCursor {
  id            String    @id @default(uuid())
  owner         String
  cursorKey     String    @map("cursor_key")
  cursorValue   String?   @map("cursor_value")
  highWatermark DateTime? @map("high_watermark")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([owner, cursorKey])
  @@map("sync_cursor")
}

model DecisionSnapshot {
  snapshotId        String   @id @map("snapshot_id")
  schemaVersion     String   @map("schema_version")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")
  contentHash       String   @map("content_hash")
  contentRef        String?  @map("content_ref")
  contentJson       Json?    @map("content_json")
  immutabilityState String   @default("sealed") @map("immutability_state")

  @@index([createdAt])
  @@map("decision_snapshot")
}
